# fxvpn-webui deployment settings.
# Copy to .env and fill in: cp .env.example .env

# ── Image ────────────────────────────────────────────────────────────────────
# Prebuilt image from GHCR (CI publishes on push to main and on v* tags).
# Pin a release for stability, e.g. ghcr.io/memories169/tuiffvpn:1.0.0
FXVPN_IMAGE=ghcr.io/memories169/tuiffvpn:latest

# ── Ports ────────────────────────────────────────────────────────────────────
# Host port for the web console (http://<host>:WEBUI_PORT)
WEBUI_PORT=9090
# Host port for the SOCKS5 proxy (starts after you pick a server).
# Mapped for BOTH TCP (tunnels) and UDP (relay) — one host port, two protocols.
SOCKS_PORT=1080

# ── UDP relay BND address ────────────────────────────────────────────────────
# The IP the torrent client is told to send UDP datagrams to. Behind docker,
# set this to the DOCKER HOST's LAN IP (what clients use to reach the proxy).
# Empty = 0.0.0.0 (works for qBittorrent; set it explicitly if trackers stay
# unreachable).
FXVPN_UDP_BND_ADDR=

# ── Ingest key ───────────────────────────────────────────────────────────────
# Secret shared with the PC userscript (scripts/fxvpn-pc-grabber.user.js):
# set CONSOLE_URL to the console address and INGEST_KEY to the SAME value as
# below, in the userscript header. Generate one with:
#   openssl rand -hex 24
# The /api/ingest endpoint stays disabled until this is set.
FXVPN_INGEST_KEY=change-me-to-a-long-random-string
