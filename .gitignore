# Build artifacts (anchored to repo root so they can never match
# nested source paths like webui/cmd/fxvpn-webui/)
/fxvpn-webui
/fxvpn-token
*.log

# Local toolchain and caches (Go + module/build caches)
/.toolchain/
/.toolcache/

# Runtime state
/data/
/state.json

# Real deployment secrets (commit only the .example files)
.env

# Local compose (generated from docker-compose.yml.example)
docker-compose.yml

# Editor
.idea/
.vscode/
*.swp